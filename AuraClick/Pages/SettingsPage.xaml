<?xml version="1.0" encoding="utf-8" ?>

<Page
    x:Class="AuraClick.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    x:DefaultBindMode="TwoWay"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="1,20,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Margin="{StaticResource ContentMargin}">
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                <win:StackPanel.ChildrenTransitions>
                    <win:EntranceThemeTransition FromVerticalOffset="50" />
                    <win:RepositionThemeTransition IsStaggeringEnabled="False" />
                </win:StackPanel.ChildrenTransitions>

                <TextBlock x:Uid="SettingsSubtitleTextBlock" Style="{StaticResource SubtitleTextBlockStyle}" />

                <TextBlock x:Uid="AppearanceSettingsSectionHeaderTextBlock" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <!--  Language  -->
                <controls:SettingsCard x:Uid="SettingsCardLanguage" HeaderIcon="{ui:FontIcon Glyph=&#xF2B7;}">
                    <ComboBox x:Name="LanguageComboBox" SelectedIndex="{x:Bind LanguageSelectedIndex}">
                        <ComboBoxItem x:Uid="ComboBoxItemLanguageSystem" />
                    </ComboBox>
                </controls:SettingsCard>
                <InfoBar
                    x:Name="LanguageRestartInfoBar"
                    x:Uid="InfoBarLanguageRestart"
                    IsClosable="False"
                    Severity="Informational">
                    <InfoBar.Resources>
                        <ResourceDictionary Source="ms-appx:///DevWinUI/Themes/InfoBarInformationalColor.xaml" />
                    </InfoBar.Resources>
                    <InfoBar.ActionButton>
                        <Button x:Uid="ButtonLanguageRestart" Click="LanguageRestartButton_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!--  Theme  -->
                <controls:SettingsCard x:Uid="SettingsCardTheme" HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                    <ComboBox SelectedIndex="{x:Bind ThemeSelectedIndex}">
                        <ComboBoxItem x:Uid="ComboBoxItemThemeSystem" />
                        <ComboBoxItem x:Uid="ComboBoxItemThemeLight" />
                        <ComboBoxItem x:Uid="ComboBoxItemThemeDark" />
                    </ComboBox>
                </controls:SettingsCard>

                <!--  Backdrop material  -->
                <controls:SettingsCard x:Uid="SettingsCardBackdropMaterial" HeaderIcon="{ui:FontIcon Glyph=&#xEF1F;}">
                    <ComboBox SelectedIndex="{x:Bind BackdropSelectedIndex}">
                        <ComboBoxItem x:Uid="ComboBoxItemBackdropMaterialMica" />
                        <ComboBoxItem x:Uid="ComboBoxItemBackdropMaterialMicaAlt" />
                        <ComboBoxItem x:Uid="ComboBoxItemBackdropMaterialAcrylic" />
                    </ComboBox>
                </controls:SettingsCard>

                <TextBlock x:Uid="TextBlockBehavior" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <!--  Always on top  -->
                <controls:SettingsCard x:Uid="SettingsCardAlwaysOnTop" HeaderIcon="{ui:FontIcon Glyph=&#xE7C4;}">
                    <ToggleSwitch IsOn="{x:Bind IsAlwaysOnTop}" />
                </controls:SettingsCard>

                <!--  Progress indicator  -->
                <controls:SettingsCard x:Uid="SettingsCardProgressIndicator" HeaderIcon="{ui:FontIcon Glyph=&#xE75B;}">
                    <ToggleSwitch IsOn="{x:Bind ProgressIndicator}" />
                </controls:SettingsCard>

                <!--  Automatic minimize  -->
                <controls:SettingsExpander x:Uid="SettingsExpanderAutomaticMinimize" HeaderIcon="{ui:FontIcon Glyph=&#xE944;}">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <CheckBox x:Uid="CheckBoxAutomaticMinimizeMinimize" IsChecked="{x:Bind AutomaticMinimizeMinimize}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <CheckBox x:Uid="CheckBoxAutomaticMinimizeRestore" IsChecked="{x:Bind AutomaticMinimizeRestore}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  Notification badge  -->
                <controls:SettingsExpander x:Uid="SettingsExpanderNotificationBadge" HeaderIcon="{ui:FontIcon Glyph=&#xEDAD;}">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <CheckBox x:Uid="CheckBoxNotificationBadgePlaying" IsChecked="{x:Bind NotificationBadgePlaying}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <CheckBox x:Uid="CheckBoxNotificationBadgePaused" IsChecked="{x:Bind NotificationBadgePaused}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <TextBlock x:Uid="TextBlockAbout" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <!--  App version  -->
                <controls:SettingsExpander
                    x:Name="AppAboutSettingsExpander"
                    Description="Copyright © 2026 Ryan Luu"
                    HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/StoreLogo.png}">
                    <controls:SettingsExpander.Resources>
                        <Thickness x:Key="HyperlinkButtonNegativeMargin">-12,0,0,0</Thickness>
                    </controls:SettingsExpander.Resources>
                    <TextBlock
                        x:Name="AppVersionTextBlock"
                        win:IsTextSelectionEnabled="True"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:SettingsExpander.Items>

                        <!--  Terms  -->
                        <controls:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                            <StackPanel>
                                <HyperlinkButton
                                    x:Uid="HyperlinkButtonPrivacyPolicy"
                                    Margin="{StaticResource HyperlinkButtonNegativeMargin}"
                                    NavigateUri="https://github.com/ryanlua/auraclick/blob/HEAD/PRIVACY_POLICY.md" />
                                <HyperlinkButton
                                    x:Uid="HyperlinkButtonLicense"
                                    Margin="{StaticResource HyperlinkButtonNegativeMargin}"
                                    NavigateUri="https://github.com/ryanlua/auraclick/blob/HEAD/COPYING.md" />
                            </StackPanel>
                        </controls:SettingsCard>

                        <!--  Related links  -->
                        <controls:SettingsCard
                            x:Uid="SettingsCardRelatedLinks"
                            HorizontalContentAlignment="Left"
                            ContentAlignment="Vertical">
                            <StackPanel>
                                <HyperlinkButton
                                    Margin="{StaticResource HyperlinkButtonNegativeMargin}"
                                    Content="Discord"
                                    NavigateUri="https://discord.gg/VVSxKCCQ5D" />
                                <HyperlinkButton
                                    Margin="{StaticResource HyperlinkButtonNegativeMargin}"
                                    Content="GitHub"
                                    NavigateUri="https://github.com/ryanlua/auraclick" />
                                <HyperlinkButton
                                    Margin="{StaticResource HyperlinkButtonNegativeMargin}"
                                    Content="Crowdin"
                                    NavigateUri="https://crowdin.com/project/auraclick" />
                            </StackPanel>
                        </controls:SettingsCard>

                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
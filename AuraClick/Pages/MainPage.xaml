<?xml version="1.0" encoding="utf-8" ?>

<Page
    x:Class="AuraClick.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:helpers="using:AuraClick.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    x:DefaultBindMode="OneWay"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <x:Double x:Key="GridSpacing">8</x:Double>
        <x:Double x:Key="HeaderSpacing">8</x:Double>
        <x:Double x:Key="NumberBoxSpacing">4</x:Double>
        <x:Double x:Key="CheckBoxHeaderSpacing">4</x:Double>
        <x:Double x:Key="ControlSpacing">4</x:Double>
        <x:Double x:Key="ButtonSpacing">8</x:Double>
    </Page.Resources>

    <Grid Margin="{StaticResource ContentMargin}" RowSpacing="{StaticResource GridSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <win:Grid.ChildrenTransitions>
            <win:EntranceThemeTransition FromVerticalOffset="50" />
            <win:RepositionThemeTransition IsStaggeringEnabled="False" />
        </win:Grid.ChildrenTransitions>

        <!--  Auto click settings  -->
        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind StartToggleButton.IsChecked, Converter={StaticResource BoolNegationConverter}}">
            <Grid RowSpacing="{StaticResource GridSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Click interval  -->
                <StackPanel Grid.ColumnSpan="2" Spacing="{StaticResource HeaderSpacing}">
                    <dev:IsEnabledTextBlock x:Uid="TextBlockClickInterval" />
                    <Grid ColumnSpacing="{StaticResource NumberBoxSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            x:Name="HoursNumberBox"
                            x:Uid="NumberBoxHours"
                            Maximum="24"
                            Minimum="0"
                            PlaceholderText="24"
                            Value="{x:Bind helpers:AutoClicker.HoursDelay, Mode=TwoWay}" />
                        <NumberBox
                            x:Name="MinutesNumberBox"
                            x:Uid="NumberBoxMinutes"
                            Grid.Column="1"
                            Maximum="60"
                            Minimum="0"
                            PlaceholderText="60"
                            Value="{x:Bind helpers:AutoClicker.MinutesDelay, Mode=TwoWay}" />
                        <NumberBox
                            x:Name="SecondsNumberBox"
                            x:Uid="NumberBoxSeconds"
                            Grid.Column="2"
                            Maximum="60"
                            Minimum="0"
                            PlaceholderText="60"
                            Value="{x:Bind helpers:AutoClicker.SecondsDelay, Mode=TwoWay}" />
                        <NumberBox
                            x:Name="MillisecondsNumberBox"
                            x:Uid="NumberBoxMilliseconds"
                            Grid.Column="3"
                            Maximum="1000"
                            Minimum="0"
                            PlaceholderText="1000"
                            SmallChange="10"
                            Value="{x:Bind helpers:AutoClicker.MillisecondsDelay, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <!--  Mouse button  -->
                <ComboBox
                    x:Name="MouseButtonComboBox"
                    x:Uid="ComboBoxMouseButton"
                    Grid.Row="1"
                    Grid.Column="0"
                    SelectedIndex="{x:Bind helpers:AutoClicker.MouseButton, Mode=TwoWay}">
                    <ComboBoxItem x:Name="LeftMouseButtonComboBoxItem" x:Uid="ComboBoxItemMouseButtonLeft" />
                    <ComboBoxItem x:Name="MiddleMouseButtonComboBoxItem" x:Uid="ComboBoxItemMouseButtonMiddle" />
                    <ComboBoxItem x:Name="RightMouseButtonComboBoxItem" x:Uid="ComboBoxItemMouseButtonRight" />
                </ComboBox>

                <!--  Hotkey  -->
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="0"
                    Spacing="{StaticResource HeaderSpacing}">
                    <dev:IsEnabledTextBlock x:Uid="TextBlockHotkey" />
                    <dev:Shortcut
                        x:Name="ToggleShortcut"
                        x:Uid="ShortcutToggle"
                        ClosedContentDialog="ToggleShortcut_ClosedContentDialog"
                        InfoTitle=""
                        OpenedContentDialog="ToggleShortcut_OpenedContentDialog"
                        PrimaryButtonClick="ToggleShortcut_PrimaryButtonClick"
                        SecondaryButtonClick="ToggleShortcut_SecondaryButtonClick"
                        WarningTitle="" />
                </StackPanel>

                <!--  Click repeat  -->
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Spacing="{StaticResource CheckBoxHeaderSpacing}">
                    <CheckBox
                        x:Name="ClickRepeatCheckBox"
                        x:Uid="CheckBoxClickRepeat"
                        IsChecked="{x:Bind helpers:AutoClicker.ClickAmountEnabled, Mode=TwoWay}" />
                    <Grid HorizontalAlignment="Left" ColumnSpacing="{StaticResource ControlSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            x:Name="ClickRepeatNumberBox"
                            IsEnabled="{x:Bind (x:Boolean)ClickRepeatCheckBox.IsChecked}"
                            LargeChange="10"
                            Minimum="1"
                            Value="{x:Bind helpers:AutoClicker.ClickAmount, Mode=TwoWay}" />
                        <dev:IsEnabledTextBlock
                            x:Uid="TextBlockClickRepeatUnit"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind (x:Boolean)ClickRepeatCheckBox.IsChecked}" />
                    </Grid>
                </StackPanel>

                <!--  Click offset  -->
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="1"
                    Spacing="{StaticResource CheckBoxHeaderSpacing}">
                    <CheckBox
                        x:Name="ClickOffsetCheckBox"
                        x:Uid="CheckBoxClickOffset"
                        IsChecked="{x:Bind helpers:AutoClicker.ClickDelayOffsetEnabled, Mode=TwoWay}" />
                    <Grid HorizontalAlignment="Left" ColumnSpacing="{StaticResource ControlSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            x:Name="ClickOffsetNumberBox"
                            AcceptsExpression="True"
                            IsEnabled="{x:Bind (x:Boolean)ClickOffsetCheckBox.IsChecked}"
                            LargeChange="25"
                            Minimum="1"
                            SmallChange="5"
                            Value="{x:Bind helpers:AutoClicker.ClickDelayOffset, Mode=TwoWay}" />
                        <dev:IsEnabledTextBlock
                            x:Uid="TextBlockClickOffsetUnit"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind (x:Boolean)ClickOffsetCheckBox.IsChecked}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ContentControl>

        <Grid
            Grid.Row="1"
            VerticalAlignment="Bottom"
            ColumnSpacing="{StaticResource ButtonSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Start auto clicker  -->
            <ToggleButton
                x:Name="StartToggleButton"
                x:Uid="ToggleButtonStart"
                Height="32"
                HorizontalAlignment="Stretch"
                Checked="StartToggleButton_Checked"
                Unchecked="StartToggleButton_Unchecked">
                <FontIcon x:Name="StartFontIcon" Glyph="&#xEE4A;" />
            </ToggleButton>

            <!--  Open settings  -->
            <Button
                x:Name="SettingsButton"
                x:Uid="ButtonSettings"
                Grid.Column="1"
                Height="32"
                Click="SettingsButton_Click"
                IsEnabled="{x:Bind StartToggleButton.IsChecked, Converter={StaticResource BoolNegationConverter}}">
                <AnimatedIcon FallbackIconSource="{ui:FontIconSource Glyph=&#xE713;}">
                    <AnimatedIcon.Source>
                        <animatedvisuals:AnimatedSettingsVisualSource />
                    </AnimatedIcon.Source>
                </AnimatedIcon>
            </Button>
        </Grid>
    </Grid>
</Page>